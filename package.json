{
  "name": "mansatas-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:attendance": "vitest run lib/attendance-status.test.ts lib/attendance-xlsx.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "security:actions": "node scripts/check-server-action-guards.js",
    "security:audit": "npm audit --omit=dev --json | node scripts/check-npm-audit.js",
    "security:vendor": "node scripts/verify-vendor-checksum.js",
    "cloudflare:types:check": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --include-runtime=false --env-file security/wrangler-types.env --check",
    "build:worker": "node scripts/cloudflare-worker-build.js",
    "preview:worker": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "cap:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build:release": "node scripts/android-release-build.js",
    "android:build:bundle": "node scripts/android-bundle-build.js",
    "db:init": "wrangler d1 execute mansatas-db --file=schema.sql",
    "db:init:remote": "wrangler d1 execute mansatas-db --remote --file=schema.sql",
    "data:prodi:validate": "node scripts/validate-prodi-data.js"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@cloudflare/puppeteer": "1.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jszip": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-to-print": "^3.3.0",
    "recharts": "^3.9.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.1.12"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "6.2.1"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "4.125.0"
  }
}
