{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mansatas-app",
  "main": "worker-entry.ts",
  "minify": true,
  "account_id": "89389959c60ad166fb81698c4289aab0",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "STATIC_ASSETS"
  },
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "d71a11d5f8ec47318b96e52f52715749" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mansatas-db",
      "database_id": "76b7b346-3f3f-4c1e-a347-2d51497bad97",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "mansatas-storage" }
  ],
  "browser": { "binding": "BROWSER" },
  "ratelimits": [
    { "name": "LOGIN_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "services": [
    { "binding": "SELF", "service": "mansatas-app" }
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "mansatas-notification-queue"
      }
    ],
    "consumers": [
      {
        "queue": "mansatas-notification-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 60,
        "max_concurrency": 1,
        "dead_letter_queue": "mansatas-notification-dlq"
      }
    ]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://mansatas-app.drudox.workers.dev",
    "ALLOWED_APP_ORIGINS": "https://mansatas-app.drudox.workers.dev,https://app.mansatas.com,capacitor://localhost,http://localhost",
    "CSP_ENFORCE": "true",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BEmCgYdnzB58tmNnAcRaSy94gkrlbqJ2TTKZNolMr8KRESnl2SCHQoo9O0lEGuA-Rjm-GdJeyeYbf9JNsMsXfm8",
    "VAPID_SUBJECT": "mailto:admin@man1tasikmalaya.sch.id"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "alias": {
    "next/dist/compiled/@vercel/og/index.edge.js": "./stubs/og-stub.js"
  }
}
